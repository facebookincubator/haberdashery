@PACKAGE_INIT@

if(NOT @HABERDASHERY_SUPPORTED@)
  set(haberdashery_FOUND FALSE)
  set(haberdashery_NOT_FOUND_MESSAGE
    "haberdashery was built for @CMAKE_SYSTEM_NAME@ @CMAKE_SYSTEM_PROCESSOR@, which has no assembly; only x86_64 and aarch64 Linux are supported")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/haberdashery-targets.cmake")
check_required_components(haberdashery)
